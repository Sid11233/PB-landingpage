    {
      "id": "91cdd7cd-8c0f-4baa-af26-3e6568329e7b",
      "name": "Manual campaign settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        220
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c85b8b71-a072-4a40-a277-af4d01c11d1f",
              "name": "identifier",
              "value": "REPLACE-with-campaign-identifier",
              "type": "string"
            },
            {
              "id": "636b403d-5943-40af-b14e-68da842f9e7c",
              "name": "callback_url",
              "value": "https://YOUR-PROJECT-REF.supabase.co/functions/v1/automation-callback",
              "type": "string"
            },
            {
              "id": "48463e33-61dc-4358-81d2-005f45c20d93",
              "name": "batch_size",
              "value": 25,
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b2cc8ecf-5f13-442b-9dd3-22296a12fe0f",
      "name": "Campaign context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        100
      ],
      "parameters": {
        "jsCode": "// Normalises both entry points into { identifier, callback_url, batch_size }.\nconst j = $input.first().json;\nif ('proceed' in j) {               // came from the Webhook + claim\n  if (!j.proceed) return [];        // duplicate trigger: stop\n  const b = $('Webhook').first().json.body;\n  return [{ json: { identifier: b.data.identifier, callback_url: b.callback_url, batch_size: 25 } }];\n}\nreturn [{ json: { identifier: j.identifier, callback_url: j.callback_url, batch_size: Number(j.batch_size) || 25 } }];"
      }
    },
    {
      "id": "cdaa166d-fd42-4e60-9f67-95fb282b8c06",
      "name": "Start campaign (select active subscribers)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        100
