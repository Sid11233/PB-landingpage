              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "0e15a303-2bf9-4fff-b6b9-a0d03d46efe5",
      "name": "One item per recipient",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json;\nreturn (b.messages || []).map((m) => ({ json: m }));"
      }
