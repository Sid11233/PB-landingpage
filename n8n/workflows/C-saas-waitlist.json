{
  "id": "sjWorkflowC00001",
  "name": "C · SaaS waiting list (confirmation + internal notification)",
  "nodes": [
    {
      "id": "b44b2da2-aa42-4291-b0b7-29fc376752c5",
      "name": "Note erz6j",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -340
      ],
      "parameters": {
        "content": "## C · SaaS waiting list\nTriggered for every new registration. The product is identified by the backend (`body.data.product`), and the emails are rendered with that product's name and description.\n\nSends: **product-specific confirmation** to the registrant + **internal notification** to NOTIFICATION_EMAIL (reply-to = registrant).\n\nDoes **not** subscribe anyone to the newsletter.\n\n**Flow:** Webhook (header auth) → claim event with the backend (prevents duplicate processing) → one item per email → Send Email via SMTP → report `smtp_accepted` / `failed` back to Supabase.\n\nSMTP failures are reported, and the backend schedules a retry that resends only the unsent emails.\n\nCredentials: **Hostinger SMTP**, **Website → n8n (X-Webhook-Secret)**, **n8n → Supabase (X-Automation-Secret)**.",
        "width": 560,
        "height": 300
      }
    },
    {
      "id": "5c993b1e-6813-4c2c-b6f0-be6a89d5f951",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "08f221ef-4953-4b34-9740-0773e6ab11f0",
      "parameters": {
        "httpMethod": "POST",
        "path": "sj-waitlist",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjWebhookAuth001",
          "name": "Website → n8n (X-Webhook-Secret)"
        }
      }
    },
    {
      "id": "198fc6a4-b767-46ce-9a57-c00a980c5d98",
      "name": "Claim event (idempotency)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.body.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'event.claim', event_id: $json.body.event_id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    },
    {
      "id": "c6695f8e-ebc7-46aa-887d-69189b61b779",
      "name": "Messages to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Stops here if the backend says this event was already processed\n// (duplicate webhook, retry, manual re-run). Otherwise emits one item per email,\n// skipping any message the SMTP server already accepted on an earlier attempt.\nconst claim = $input.first().json;\nif (!claim.proceed) return [];\nconst event = $('Webhook').first().json.body;\nconst alreadySent = new Set(claim.already_sent || []);\nreturn (event.messages || [])\n  .filter((m) => !alreadySent.has(m.type))\n  .map((m) => ({ json: { ...m, event_id: event.event_id, event_type: event.event_type, callback_url: event.callback_url } }));"
      }
    },
    {
      "id": "ba5b2018-9258-495e-be64-828fb0a73030",
      "name": "Send email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.reply_to || '' }}"
        }
      },
      "credentials": {
        "smtp": {
          "id": "sjSmtpHostinger1",
          "name": "Hostinger SMTP"
        }
      }
    },
    {
      "id": "cd8b6044-f597-474f-b0ff-5611df2db143",
      "name": "Report SMTP result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Messages to send').item.json.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  action: 'email.result',\n  event_id: $('Messages to send').item.json.event_id,\n  message_type: $('Messages to send').item.json.type,\n  status: $json.error ? 'failed' : 'smtp_accepted',\n  smtp_message_id: $json.messageId || null,\n  smtp_response: $json.response || null,\n  error: $json.error ? String($json.error.message || $json.error.description || $json.error) : null\n}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    }
  ],
