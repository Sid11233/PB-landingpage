{
  "id": "sjWorkflowB00001",
  "name": "B · Newsletter confirmed (welcome email)",
  "nodes": [
    {
      "id": "d5f0ccb1-0b33-4f54-a994-c43645a8eddf",
      "name": "Note d8mp1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -340
      ],
      "parameters": {
        "content": "## B · Newsletter confirmation\nTriggered after the backend has validated the token and activated the subscriber. Sends the **welcome email** (with unsubscribe link).\n\n**Flow:** Webhook (header auth) → claim event with the backend (prevents duplicate processing) → one item per email → Send Email via SMTP → report `smtp_accepted` / `failed` back to Supabase.\n\nSMTP failures are reported, and the backend schedules a retry that resends only the unsent emails.\n\nCredentials: **Hostinger SMTP**, **Website → n8n (X-Webhook-Secret)**, **n8n → Supabase (X-Automation-Secret)**.",
        "width": 560,
        "height": 300
      }
    },
    {
      "id": "a6a1c70b-263e-42ae-b103-26513177190f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "d44bd5cc-cf3f-46a3-8216-81e8edb5ee1c",
      "parameters": {
        "httpMethod": "POST",
        "path": "sj-newsletter-confirmed",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjWebhookAuth001",
          "name": "Website → n8n (X-Webhook-Secret)"
        }
      }
    },
    {
      "id": "3df6dd05-8734-449e-a5d9-facf09f77e6d",
      "name": "Claim event (idempotency)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.body.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'event.claim', event_id: $json.body.event_id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    },
    {
      "id": "cdb4665e-46c4-4012-aef7-71226475222f",
      "name": "Messages to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Stops here if the backend says this event was already processed\n// (duplicate webhook, retry, manual re-run). Otherwise emits one item per email,\n// skipping any message the SMTP server already accepted on an earlier attempt.\nconst claim = $input.first().json;\nif (!claim.proceed) return [];\nconst event = $('Webhook').first().json.body;\nconst alreadySent = new Set(claim.already_sent || []);\nreturn (event.messages || [])\n  .filter((m) => !alreadySent.has(m.type))\n  .map((m) => ({ json: { ...m, event_id: event.event_id, event_type: event.event_type, callback_url: event.callback_url } }));"
      }
    },
    {
      "id": "33d8d783-17ad-4a63-9fdb-1431761e09e9",
      "name": "Send email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.reply_to || '' }}"
        }
      },
      "credentials": {
        "smtp": {
          "id": "sjSmtpHostinger1",
          "name": "Hostinger SMTP"
        }
      }
    },
    {
      "id": "651b1039-92c7-472f-b833-c9a8361dc510",
      "name": "Report SMTP result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Messages to send').item.json.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  action: 'email.result',\n  event_id: $('Messages to send').item.json.event_id,\n  message_type: $('Messages to send').item.json.type,\n  status: $json.error ? 'failed' : 'smtp_accepted',\n  smtp_message_id: $json.messageId || null,\n  smtp_response: $json.response || null,\n  error: $json.error ? String($json.error.message || $json.error.description || $json.error) : null\n}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    }
  ],
