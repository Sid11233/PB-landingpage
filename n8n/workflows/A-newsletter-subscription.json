{
  "id": "sjWorkflowA00001",
  "name": "A · Newsletter subscription (double opt-in email)",
  "nodes": [
    {
      "id": "1dff17cd-80cc-4d87-80a8-6a39cee24ec3",
      "name": "Note k7ys3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -340
      ],
      "parameters": {
        "content": "## A · Newsletter subscription\nTriggered when someone subscribes. Sends the **double opt-in confirmation email** (single-use link, generated by the backend; only its hash is stored).\n\n**Flow:** Webhook (header auth) → claim event with the backend (prevents duplicate processing) → one item per email → Send Email via SMTP → report `smtp_accepted` / `failed` back to Supabase.\n\nSMTP failures are reported, and the backend schedules a retry that resends only the unsent emails.\n\nCredentials: **Hostinger SMTP**, **Website → n8n (X-Webhook-Secret)**, **n8n → Supabase (X-Automation-Secret)**.",
        "width": 560,
        "height": 300
      }
    },
    {
      "id": "62cafc52-f742-4381-8e01-f9434ad786f6",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "42b28b93-347f-47fc-9eeb-cc01f7a4dfc0",
      "parameters": {
        "httpMethod": "POST",
        "path": "sj-newsletter-subscribe",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjWebhookAuth001",
          "name": "Website → n8n (X-Webhook-Secret)"
        }
      }
    },
    {
      "id": "2c84aa3e-e8de-4559-9e3b-404b9b195b92",
      "name": "Claim event (idempotency)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.body.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'event.claim', event_id: $json.body.event_id }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    },
    {
      "id": "bd6d4f40-c687-4d71-af6f-191d7cf8a891",
      "name": "Messages to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Stops here if the backend says this event was already processed\n// (duplicate webhook, retry, manual re-run). Otherwise emits one item per email,\n// skipping any message the SMTP server already accepted on an earlier attempt.\nconst claim = $input.first().json;\nif (!claim.proceed) return [];\nconst event = $('Webhook').first().json.body;\nconst alreadySent = new Set(claim.already_sent || []);\nreturn (event.messages || [])\n  .filter((m) => !alreadySent.has(m.type))\n  .map((m) => ({ json: { ...m, event_id: event.event_id, event_type: event.event_type, callback_url: event.callback_url } }));"
      }
    },
    {
      "id": "335468bd-731e-4d79-8782-b37ccda4c644",
      "name": "Send email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "fromEmail": "={{ $json.from }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $json.reply_to || '' }}"
        }
      },
      "credentials": {
        "smtp": {
          "id": "sjSmtpHostinger1",
          "name": "Hostinger SMTP"
        }
      }
    },
    {
      "id": "9dfd9266-f3f4-491f-b26f-6b623c9f7ee2",
      "name": "Report SMTP result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $('Messages to send').item.json.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  action: 'email.result',\n  event_id: $('Messages to send').item.json.event_id,\n  message_type: $('Messages to send').item.json.type,\n  status: $json.error ? 'failed' : 'smtp_accepted',\n  smtp_message_id: $json.messageId || null,\n  smtp_response: $json.response || null,\n  error: $json.error ? String($json.error.message || $json.error.description || $json.error) : null\n}) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "sjCallbackAuth01",
          "name": "n8n → Supabase (X-Automation-Secret)"
        }
      }
    }
  ],
  "connections": {
