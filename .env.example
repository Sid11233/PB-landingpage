# =============================================================================
# Environment variables: copy the relevant parts; NEVER commit real values.
#
# There are THREE places configuration lives:
#   1. Website build (public; ends up in the browser)  -> your hosting dashboard, or site.config.mjs
#   2. Supabase Edge Function secrets (private)        -> `npx supabase secrets set --env-file ...`
#   3. n8n credentials (SMTP password etc.)            -> inside n8n only (see docs/SETUP.md)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. WEBSITE BUILD (public). These override site.config.mjs at `npm run build`.
# -----------------------------------------------------------------------------
SITE_URL=https://yourdomain.com
SITE_NAME=Sid Jugasing
# Supabase Edge Functions base URL (public; contains no secret)
PUBLIC_API_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1
CONTACT_EMAIL=
CONTACT_PHONE=
PRIVACY_EMAIL=
LEGAL_CONTROLLER_NAME=Sid Jugasing
# Social / external links: full URLs, empty = hidden
INSTAGRAM_URL=
LINKEDIN_URL=
TIKTOK_URL=
X_URL=
GITHUB_URL=
YOUTUBE_URL=
AGENTRA_URL=https://agentra.mu
CATALYST_URL=
MAUTALK_URL=
DOLCE_ATTIRES_URL=
# Optional cookieless analytics: plausible | umami
ANALYTICS_PROVIDER=
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=

# -----------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTION SECRETS (private). Put these in
#    supabase/.env.production (gitignored) and run:
#      npx supabase secrets set --env-file supabase/.env.production
# -----------------------------------------------------------------------------
# Provided automatically by Supabase in deployed functions. Do NOT set them yourself:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# (The anon/publishable key is not used anywhere: the browser needs no Supabase key.)

# Website
SITE_URL=https://yourdomain.com
SITE_NAME=Sid Jugasing
# Comma-separated origins allowed to call the form endpoints (include www if used)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Public base URL of the functions, used by n8n for callbacks (default: SUPABASE_URL/functions/v1)
PUBLIC_FUNCTIONS_URL=

# Email configuration (addresses only; SMTP credentials live in n8n)
SENDER_EMAIL=hello@yourdomain.com
SENDER_NAME=Sid Jugasing
NOTIFICATION_EMAIL=you@yourdomain.com
# Optional sentence added to the contact acknowledgement, e.g. "I usually reply within two working days."
CONTACT_RESPONSE_TIME=
# Send a one-time "you're unsubscribed" email (default false)
SEND_UNSUBSCRIBE_CONFIRMATION=false
CONFIRM_TOKEN_TTL_HOURS=72

# n8n: set N8N_BASE_URL and the default webhook paths are used,
# or set any individual URL to override it.
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_NEWSLETTER_WEBHOOK_URL=
N8N_NEWSLETTER_CONFIRMATION_WEBHOOK_URL=
N8N_WAITLIST_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_URL=
N8N_UNSUBSCRIBE_WEBHOOK_URL=
N8N_CAMPAIGN_WEBHOOK_URL=

# Shared secrets: generate each with:  openssl rand -base64 32
# Sent as X-Webhook-Secret to n8n (same value in n8n credential "Website → n8n (X-Webhook-Secret)")
N8N_WEBHOOK_SECRET=
# Sent by n8n as X-Automation-Secret (same value in n8n credential "n8n → Supabase (X-Automation-Secret)")
AUTOMATION_CALLBACK_SECRET=
# Sent by pg_cron as X-Dispatch-Secret (same value in supabase/setup/schedule-jobs.sql)
DISPATCH_SECRET=
# Signs unsubscribe links. Changing it invalidates links in emails already sent.
UNSUBSCRIBE_TOKEN_SECRET=
# Optional; defaults to UNSUBSCRIBE_TOKEN_SECRET
RATE_LIMIT_SALT=
